FROM rust:1.75-slim as builder

WORKDIR /build

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY server/Cargo.toml server/Cargo.lock ./
RUN mkdir src && touch src/lib.rs src/main.rs

RUN cargo build --release && rm -rf src

COPY server/ .
RUN rm src/lib.rs src/main.rs && mkdir src
COPY server/src ./src

RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r keyforge && useradd -r -g keyforge keyforge

WORKDIR /app

COPY --from=builder /build/target/release/keyforge-server /app/

RUN chown -R keyforge:keyforge /app

USER keyforge

EXPOSE 8080

ENV KEYFORGE_DATA_DIR=/data \
    KEYFORGE_LOG_LEVEL=info

VOLUME ["/data"]

ENTRYPOINT ["/app/keyforge-server"]
CMD ["--data-dir", "/data"]
